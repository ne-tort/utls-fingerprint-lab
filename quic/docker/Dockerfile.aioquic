# Minimal aioquic H3 client → lab capture (UDP Initial only).
FROM python:3.12-slim-bookworm
WORKDIR /app
COPY emitters/aioquic/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY emitters/aioquic/emit_initial.py /app/emit_initial.py
ENTRYPOINT ["python", "/app/emit_initial.py"]
