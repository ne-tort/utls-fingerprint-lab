FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY bin/quic-capture /app/quic-capture
RUN chmod +x /app/quic-capture && mkdir -p /captures /profiles
EXPOSE 4433/udp
ENTRYPOINT ["/app/quic-capture"]
