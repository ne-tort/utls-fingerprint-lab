# JA4 q… annotator for quic-raw-initial-v1 profiles.
# Build from utls-fingerprint-docker/ (parent of quic/) so _refs/ is visible:
#   docker build -f quic/docker/Dockerfile.ja4plus -t quic-ja4plus .
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends libpcap0.8 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY _refs/ja4plus /tmp/ja4plus
RUN pip install --no-cache-dir /tmp/ja4plus
COPY quic/scripts/annotate_ja4.py /app/annotate_ja4.py
WORKDIR /work
ENTRYPOINT ["python", "/app/annotate_ja4.py"]
