{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quic-raw-initial-v1",
  "title": "quic-raw-initial-v1 profile manifest",
  "type": "object",
  "required": ["format", "id", "family", "expected"],
  "properties": {
    "format": { "const": "quic-raw-initial-v1" },
    "id": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "minLength": 1 },
    "version": { "type": "number" },
    "track": { "enum": ["latest", "pinned"] },
    "expected": {
      "type": "object",
      "properties": {
        "ja4": { "type": "string" },
        "clienthellod_id": { "type": "string" },
        "tp_id_set": {
          "type": "array",
          "items": { "type": "string" }
        },
        "dcid_len": { "type": ["integer", "null"] },
        "scid_len": { "type": ["integer", "null"] }
      }
    },
    "notes": { "type": "string" }
  }
}
