# syntax=docker/dockerfile:1.7
# Optional full in-docker build (needs working module proxy DNS).
FROM golang:1.24-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY *.go ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/capture .

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/capture /app/capture
RUN mkdir -p /captures /profiles /app/certs
EXPOSE 8443
ENTRYPOINT ["/app/capture", "-listen", ":8443", "-out", "/captures", "-profiles", "/profiles"]
