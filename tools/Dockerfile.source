# syntax=docker/dockerfile:1.7
FROM golang:1.24-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/verify ./cmd/verify \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/emit-builtin ./cmd/emit-builtin \
 && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/labctl ./cmd/labctl

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/verify /usr/local/bin/verify
COPY --from=build /out/emit-builtin /usr/local/bin/emit-builtin
COPY --from=build /out/labctl /usr/local/bin/labctl
WORKDIR /work
ENTRYPOINT ["labctl"]
